			vmmc-supply = <0x14>;
		};

		mmc1: mmc@4021000 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			bus-width = <0x04>;
			cap-mmc-highspeed;
			cap-sd-highspeed;
			cap-sdio-irq;
			clock-names = "ahb", "mmc";
			clocks = <0x02 0x40 0x02 0x3d>;
			compatible = "allwinner,sun50i-h616-mmc", "allwinner,sun50i-a100-mmc";
			interrupts = <0x00 0x24 0x04>;
			max-frequency = <0x8f0d180>;
			mmc-ddr-3_3v;
			mmc-pwrseq = <0x17>;
			non-removable;
			phandle = <0x6b>;
			pinctrl-0 = <0x15>;
			pinctrl-names = "default";
			reg = <0x4021000 0x1000>;
			reset-names = "ahb";
			resets = <0x02 0x0f>;
			status = "okay";
			vmmc-supply = <0x14>;
			vqmmc-supply = <0x16>;

			wlan: wifi@1 {
				interrupt-names = "host-wake";
				interrupt-parent = <0x18>;
				interrupts = <0x06 0x0f 0x01>;
				phandle = <0x6c>;
				reg = <0x01>;
			};
		};

		mmc2: mmc@4022000 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			bus-width = <0x08>;
			cap-mmc-highspeed;
			cap-mmc-hw-reset;
			cap-sd-highspeed;
			cap-sdio-irq;
			clock-names = "ahb", "mmc";
			clocks = <0x02 0x41 0x02 0x3e>;
			compatible = "allwinner,sun50i-h616-emmc", "allwinner,sun50i-a100-emmc";
			interrupts = <0x00 0x25 0x04>;
			max-frequency = <0x8f0d180>;
			mmc-ddr-3_3v;
			non-removable;
			phandle = <0x6d>;
			pinctrl-0 = <0x19>;
			pinctrl-names = "default";
			reg = <0x4022000 0x1000>;
			reset-names = "ahb";
			resets = <0x02 0x10>;
			status = "okay";
			vmmc-supply = <0x14>;
		};

		usbphy: phy@5100400 {
			#phy-cells = <0x01>;
			clock-names = "usb0_phy", "usb1_phy", "usb2_phy", "usb3_phy", "pmu2_clk";
			clocks = <0x02 0x61 0x02 0x63 0x02 0x65 0x02 0x67 0x02 0x6e>;
			compatible = "allwinner,sun50i-h616-usb-phy";
			phandle = <0x2a>;
			reg = <0x5100400 0x24 0x5101800 0x14 0x5200800 0x14 0x5310800 0x14 0x5311800 0x14>;
			reg-names = "phy_ctrl", "pmu0", "pmu1", "pmu2", "pmu3";
			reset-names = "usb0_reset", "usb1_reset", "usb2_reset", "usb3_reset";
			resets = <0x02 0x26 0x02 0x27 0x02 0x28 0x02 0x29>;
			status = "okay";
			usb1_vbus-supply = <0x2b>;
		};

		pio: pinctrl@300b000 {
			#gpio-cells = <0x03>;
			#interrupt-cells = <0x03>;
			clock-names = "apb", "hosc", "losc";
			clocks = <0x02 0x1a 0x12 0x10 0x00>;
			compatible = "allwinner,sun50i-h616-pinctrl";
			gpio-controller;
			interrupt-controller;
			interrupts = <0x00 0x33 0x04 0x00 0x34 0x04 0x00 0x35 0x04 0x00 0x2b 0x04 0x00 0x36 0x04 0x00 0x37 0x04 0x00 0x38 0x04 0x00 0x39 0x04>;
			phandle = <0x18>;
			reg = <0x300b000 0x400>;

			i2c0_pins: i2c0-pins {
				function = "i2c0";
				phandle = <0x1f>;
				pins = "PI5", "PI6";
			};

			i2c1_pi_pins: i2c1-pi-pins {
				function = "i2c1";
				phandle = <0x49>;
				pins = "PI7", "PI8";
			};

			i2c2_ph_pins: i2c2-ph-pins {
				function = "i2c2";
				phandle = <0x4a>;
				pins = "PH2", "PH3";
			};

			i2c2_pi_pins: i2c2-pi-pins {
				function = "i2c2";
				phandle = <0x4b>;
				pins = "PI9", "PI10";
			};

			i2c3_pa_pins: i2c3-pa-pins {
				bias-pull-up;
				function = "i2c3";
				phandle = <0x4c>;
				pins = "PA10", "PA11";
			};

			i2c3_pg_pins: i2c3-pg-pins {
				function = "i2c3";
				phandle = <0x4d>;
				pins = "PG17", "PG18";
			};

			i2c3_ph_pins: i2c3-ph-pins {
				function = "i2c3";
				phandle = <0x4e>;
				pins = "PH4", "PH5";
			};

			i2c4_pg_pins: i2c4-pg-pins {
				function = "i2c4";
				phandle = <0x4f>;
				pins = "PG15", "PG16";
			};

			i2c4_ph_pins: i2c4-ph-pins {
				function = "i2c4";
				phandle = <0x50>;
				pins = "PH6", "PH7";
			};

			i2s2_pins: i2s2-pins {
				function = "i2s2";
				phandle = <0x51>;
				pins = "PG10", "PG11", "PG12", "PG13", "PG14";
			};

			i2s3_pins: i2s3-pins {
				function = "i2s3";
				phandle = <0x52>;
				pins = "PH5", "PH6", "PH7", "PH8", "PH9";
			};

			ir_rx_pin: ir-rx-pin {
				function = "ir_rx";
				phandle = <0x37>;
				pins = "PH10";
			};

			mmc0_pins: mmc0-pins {
				bias-pull-up;
				drive-strength = <0x1e>;
				function = "mmc0";
				phandle = <0x13>;
				pins = "PF0", "PF1", "PF2", "PF3", "PF4", "PF5";
			};

			mmc1_pins: mmc1-pins {
				bias-pull-up;
				drive-strength = <0x1e>;
				function = "mmc1";
				phandle = <0x15>;
				pins = "PG0", "PG1", "PG2", "PG3", "PG4", "PG5";
			};

			mmc2_pins: mmc2-pins {
				bias-pull-up;
				drive-strength = <0x1e>;
				function = "mmc2";
				phandle = <0x19>;
				pins = "PC0", "PC1", "PC5", "PC6", "PC8", "PC9", "PC10", "PC11", "PC13", "PC14", "PC15", "PC16";
			};

			pwm1_pg_pin: pwm1-pg-pin {
				function = "pwm1";
				phandle = <0x53>;
				pins = "PG19";
			};

			pwm1_ph_pin: pwm1-ph-pin {
				function = "pwm1";
				phandle = <0x54>;
				pins = "PH3";
			};

			pwm1_pi_pin: pwm1-pi-pin {
				function = "pwm1";
				phandle = <0x55>;
				pins = "PI11";
			};

			pwm2_ph_pin: pwm2-ph-pin {
				function = "pwm2";
				phandle = <0x56>;
				pins = "PH2";
			};

			pwm3_ph_pin: pwm3-ph-pin {
				function = "pwm3";
				phandle = <0x57>;
				pins = "PH0";
			};

			pwm4_ph_pin: pwm4-ph-pin {
				function = "pwm4";
				phandle = <0x58>;
				pins = "PH1";
			};

			pwm5_pin: pwm5-pin {
				bias-pull-up;
				function = "pwm5";
				phandle = <0x59>;
				pins = "PA12";
			};

			ext_rgmii_pins: rgmii-pins {
				drive-strength = <0x28>;
				function = "emac0";
				phandle = <0x48>;
				pins = "PI0", "PI1", "PI2", "PI3", "PI4", "PI5", "PI7", "PI8", "PI9", "PI10", "PI11", "PI12", "PI13", "PI14", "PI15";
			};

			rmii_pins: rmii-pins {
				drive-strength = <0x28>;
				function = "emac1";
				phandle = <0x21>;
				pins = "PA0", "PA1", "PA2", "PA3", "PA4", "PA5", "PA6", "PA7", "PA8", "PA9";
			};

			spdif_tx_pin: spdif-tx-pin {
				function = "spdif";
				phandle = <0x24>;
				pins = "PH4";
			};

			spi0_cs0_pin: spi0-cs0-pin {
				function = "spi0";
				phandle = <0x5b>;
				pins = "PC3";
			};

			spi0_pins: spi0-pins {
				function = "spi0";
				phandle = <0x5a>;
				pins = "PC0", "PC2", "PC4";
			};

			spi1_cs0_pin: spi1-cs0-pin {
				function = "spi1";
				phandle = <0x5d>;
				pins = "PH5";
			};

			spi1_cs1_pin: spi1-cs1-pin {
				function = "spi1";
				phandle = <0x5e>;
				pins = "PH9";
			};

			spi1_pins: spi1-pins {
				function = "spi1";
				phandle = <0x5c>;
				pins = "PH6", "PH7", "PH8";
			};

			uart0_ph_pins: uart0-ph-pins {
				function = "uart0";
				phandle = <0x1b>;
				pins = "PH0", "PH1";
			};

			uart1_pins: uart1-pins {
				function = "uart1";
				phandle = <0x1c>;
				pins = "PG6", "PG7";
			};

			uart1_rts_cts_pins: uart1-rts-cts-pins {
				function = "uart1";
				phandle = <0x1d>;
				pins = "PG8", "PG9";
			};

			uart2_pg_pins: uart2-pg-pins {
				function = "uart2";
				phandle = <0x60>;
				pins = "PG15", "PG16";
			};

			uart2_pg_rts_cts_pins: uart2-pg-rts-cts-pins {
				function = "uart2";
				phandle = <0x61>;
				pins = "PG17", "PG18";
			};

			uart2_ph_pins: uart2-ph-pins {
				function = "uart2";
				phandle = <0x62>;
				pins = "PH5", "PH6";
			};

			uart2_ph_rts_cts_pins: uart2-ph-rts-cts-pins {
				function = "uart2";
				phandle = <0x63>;
				pins = "PH7", "PH8";
			};

			uart2_pi_pins: uart2-pi-pins {
				function = "uart2";
				phandle = <0x5f>;
				pins = "PI5", "PI6";
			};

			uart3_pi_pins: uart3-pi-pins {
				function = "uart3";
				phandle = <0x64>;
				pins = "PI9", "PI10";
			};

			uart4_pi_pins: uart4-pi-pins {
				function = "uart4";
				phandle = <0x65>;
				pins = "PI13", "PI14";
			};

			uart4_pi_rts_cts_pins: uart4-pi-rts-cts-pins {
				function = "uart4";
				phandle = <0x66>;
				pins = "PI15", "PI16";
			};

			uart5_pins: uart5-pins {
				function = "uart5";
				phandle = <0x67>;
				pins = "PH2", "PH3";
			};

			x32clk_fanout_pin: x32clk-fanout-pin {
				function = "clock";
				phandle = <0x68>;
				pins = "PG10";
			};
		};

		r_pio: pinctrl@7022000 {
			#gpio-cells = <0x03>;
			clock-names = "apb", "hosc", "losc";
			clocks = <0x36 0x02 0x12 0x10 0x00>;
			compatible = "allwinner,sun50i-h616-r-pinctrl";
			gpio-controller;
			phandle = <0x1e>;
			reg = <0x7022000 0x400>;

			r_i2c_pins: r-i2c-pins {
				function = "s_i2c";
				phandle = <0x38>;
				pins = "PL0", "PL1";
			};

			r_rsb_pins: r-rsb-pins {
				function = "s_rsb";
				phandle = <0x3a>;
				pins = "PL0", "PL1";
			};
		};

		prcm_ppu: power-controller@7010250 {
			#power-domain-cells = <0x01>;
			compatible = "allwinner,sun50i-h616-prcm-ppu";
			phandle = <0x0e>;
			reg = <0x7010250 0x10>;
		};

		pwm@300a000 {
			#clock-cells = <0x01>;
			#pwm-cells = <0x03>;
			clock-names = "mod", "bus";
			clocks = <0x12 0x02 0x2f>;
			compatible = "allwinner,sun50i-h616-pwm";
			phandle = <0xa9>;
			pinctrl-0 = <0x59>;
			pinctrl-names = "default";
			pwm-base = <0x00>;
			pwm-number = <0x06>;
			reg = <0x300a000 0x400>;
			resets = <0x02 0x0a>;
			status = "okay";
		};

		r_rsb: rsb@7083000 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			clock-frequency = <0x2dc6c0>;
			clocks = <0x36 0x0d>;
			compatible = "allwinner,sun50i-h616-rsb", "allwinner,sun8i-a23-rsb";
			interrupts = <0x00 0x6d 0x04>;
			phandle = <0xa0>;
			pinctrl-0 = <0x3a>;
			pinctrl-names = "default";
			reg = <0x7083000 0x400>;
			resets = <0x36 0x07>;
			status = "disabled";
		};

		rtc: rtc@7000000 {
			#clock-cells = <0x01>;
			clock-names = "bus", "hosc", "pll-32k";
			clocks = <0x36 0x0e 0x12 0x02 0x80>;
			compatible = "allwinner,sun50i-h616-rtc";
			interrupts = <0x00 0x68 0x04>;
			phandle = <0x10>;
			reg = <0x7000000 0x400>;
		};

		uart0: serial@5000000 {
			clocks = <0x02 0x42>;
			compatible = "snps,dw-apb-uart";
			dma-names = "tx", "rx";
			dmas = <0x1a 0x0e 0x1a 0x0e>;
			interrupts = <0x00 0x00 0x04>;
			phandle = <0x6e>;
			pinctrl-0 = <0x1b>;
			pinctrl-names = "default";
			reg = <0x5000000 0x400>;
			reg-io-width = <0x04>;
			reg-shift = <0x02>;
			resets = <0x02 0x11>;
			status = "okay";
		};

		uart1: serial@5000400 {
			clocks = <0x02 0x43>;
			compatible = "snps,dw-apb-uart";
			dma-names = "tx", "rx";
			dmas = <0x1a 0x0f 0x1a 0x0f>;
			interrupts = <0x00 0x01 0x04>;
			phandle = <0x6f>;
			pinctrl-0 = <0x1c 0x1d>;
			pinctrl-names = "default";
			reg = <0x5000400 0x400>;
			reg-io-width = <0x04>;
			reg-shift = <0x02>;
			resets = <0x02 0x12>;
			status = "okay";
			uart-has-rtscts;

			bluetooth {
				clock-names = "lpo";
				clocks = <0x10 0x01>;
				compatible = "brcm,bcm43438-bt";
				device-wakeup-gpios = <0x1e 0x00 0x06 0x00>;
				host-wakeup-gpios = <0x1e 0x00 0x05 0x00>;
				shutdown-gpios = <0x1e 0x00 0x04 0x00>;
				vbat-supply = <0x14>;
				vddio-supply = <0x14>;
			};
		};

		uart2: serial@5000800 {
			clocks = <0x02 0x44>;
			compatible = "snps,dw-apb-uart";
			dma-names = "tx", "rx";
			dmas = <0x1a 0x10 0x1a 0x10>;
			interrupts = <0x00 0x02 0x04>;
			phandle = <0x70>;
			reg = <0x5000800 0x400>;
			reg-io-width = <0x04>;
			reg-shift = <0x02>;
			resets = <0x02 0x13>;
			status = "disabled";
		};

		uart3: serial@5000c00 {
			clocks = <0x02 0x45>;
			compatible = "snps,dw-apb-uart";
			dma-names = "tx", "rx";
			dmas = <0x1a 0x11 0x1a 0x11>;
			interrupts = <0x00 0x03 0x04>;
			phandle = <0x71>;
			reg = <0x5000c00 0x400>;
			reg-io-width = <0x04>;
			reg-shift = <0x02>;
			resets = <0x02 0x14>;
			status = "disabled";
		};

		uart4: serial@5001000 {
			clocks = <0x02 0x46>;
			compatible = "snps,dw-apb-uart";
			dma-names = "tx", "rx";
			dmas = <0x1a 0x12 0x1a 0x12>;
			interrupts = <0x00 0x04 0x04>;
			phandle = <0x72>;
			reg = <0x5001000 0x400>;
			reg-io-width = <0x04>;
			reg-shift = <0x02>;
			resets = <0x02 0x15>;
			status = "disabled";
		};

		uart5: serial@5001400 {
			clocks = <0x02 0x47>;
			compatible = "snps,dw-apb-uart";
			dma-names = "tx", "rx";
			dmas = <0x1a 0x13 0x1a 0x13>;
			interrupts = <0x00 0x05 0x04>;
			phandle = <0x73>;
			reg = <0x5001400 0x400>;
			reg-io-width = <0x04>;
			reg-shift = <0x02>;
			resets = <0x02 0x16>;
			status = "disabled";
		};

		spdif: spdif@5093000 {
			#sound-dai-cells = <0x00>;
			clock-names = "apb", "spdif";
			clocks = <0x02 0x58 0x02 0x57>;
			compatible = "allwinner,sun50i-h616-spdif";
			dma-names = "tx";
			dmas = <0x1a 0x02>;
			interrupts = <0x00 0x15 0x04>;
			phandle = <0x7f>;
			pinctrl-0 = <0x24>;
			pinctrl-names = "default";
			reg = <0x5093000 0x400>;
			resets = <0x02 0x22>;
			status = "disabled";
		};

		spi0: spi@5010000 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			clock-names = "ahb", "mod";
			clocks = <0x02 0x4f 0x02 0x4d>;
			compatible = "allwinner,sun50i-h616-spi", "allwinner,sun8i-h3-spi";
			dma-names = "rx", "tx";
			dmas = <0x1a 0x16 0x1a 0x16>;
			interrupts = <0x00 0x0c 0x04>;
			phandle = <0x79>;
			reg = <0x5010000 0x1000>;
			resets = <0x02 0x1c>;
			status = "disabled";
		};

		spi1: spi@5011000 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			clock-names = "ahb", "mod";
			clocks = <0x02 0x50 0x02 0x4e>;
			compatible = "allwinner,sun50i-h616-spi", "allwinner,sun8i-h3-spi";
			dma-names = "rx", "tx";
			dmas = <0x1a 0x17 0x1a 0x17>;
			interrupts = <0x00 0x0d 0x04>;
			phandle = <0x7a>;
			reg = <0x5011000 0x1000>;
			resets = <0x02 0x1d>;
			status = "disabled";
		};

		sunxi-info {
			compatible = "allwinner,sun50i-h616-sys-info";
			status = "okay";
		};

		syscon: syscon@3000000 {
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			compatible = "allwinner,sun50i-h616-system-control";
			phandle = <0x20>;
			ranges;
			reg = <0x3000000 0x30 0x3000038 0xfc8>;

			sram_a2: sram@100000 {
				#address-cells = <0x01>;
				#size-cells = <0x01>;
				compatible = "mmio-sram";
				phandle = <0x42>;
				ranges = <0x00 0x100000 0x18000>;
				reg = <0x100000 0x18000>;

				scpi_sram: scpi-sram@17c00 {
					compatible = "arm,scp-shmem";
					phandle = <0x43>;
					reg = <0x17c00 0x200>;
				};
			};

			sram_c1: sram@1a00000 {
				#address-cells = <0x01>;
				#size-cells = <0x01>;
				compatible = "mmio-sram";
				phandle = <0x45>;
				ranges = <0x00 0x1a00000 0x200000>;
				reg = <0x1a00000 0x200000>;

				ve_sram: sram-section@0 {
					compatible = "allwinner,sun50i-h616-sram-c1";
					phandle = <0x11>;
					reg = <0x00 0x200000>;
				};
			};

			sram_c: sram@28000 {
				#address-cells = <0x01>;
				#size-cells = <0x01>;
				compatible = "mmio-sram";
				phandle = <0x44>;
				ranges = <0x00 0x28000 0x30000>;
				reg = <0x28000 0x30000>;

				de3_sram: sram-section@0 {
					compatible = "allwinner,sun50i-h616-sram-c", "allwinner,sun50i-a64-sram-c";
					phandle = <0x0b>;
					reg = <0x00 0x1e000>;
				};
			};
		};

		tcon_top: tcon-top@6510000 {
			#clock-cells = <0x01>;
			clock-names = "bus", "tcon-tv0";
			clock-output-names = "tcon-top-tv0";
			clocks = <0x02 0x76 0x02 0x77>;
			compatible = "allwinner,sun50i-h6-tcon-top";
			phandle = <0x33>;
			reg = <0x6510000 0x1000>;
			resets = <0x02 0x35>;

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				tcon_top_mixer0_in: port@0 {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					phandle = <0x94>;
					reg = <0x00>;

					tcon_top_mixer0_in_mixer0: endpoint@0 {
						phandle = <0x0d>;
						reg = <0x00>;
						remote-endpoint = <0x2f>;
					};
				};

				tcon_top_mixer0_out: port@1 {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					phandle = <0x95>;
					reg = <0x01>;

					tcon_top_mixer0_out_tcon_tv: endpoint@2 {
						phandle = <0x34>;
						reg = <0x02>;
						remote-endpoint = <0x30>;
					};
				};

				tcon_top_hdmi_in: port@4 {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					phandle = <0x96>;
					reg = <0x04>;

					tcon_top_hdmi_in_tcon_tv: endpoint@0 {
						phandle = <0x35>;
						reg = <0x00>;
						remote-endpoint = <0x31>;
					};
				};

				tcon_top_hdmi_out: port@5 {
					phandle = <0x97>;
					reg = <0x05>;

					tcon_top_hdmi_out_hdmi: endpoint {
						phandle = <0x2d>;
						remote-endpoint = <0x32>;
					};
				};
			};
		};

		ths: thermal-sensor@5070400 {
			#thermal-sensor-cells = <0x01>;
			allwinner,sram = <0x20>;
			clock-names = "bus";
			clocks = <0x02 0x56>;
			compatible = "allwinner,sun50i-h616-ths";
			interrupts = <0x00 0x13 0x04>;
			nvmem-cell-names = "calibration";
			nvmem-cells = <0x25>;
			phandle = <0x3b>;
			reg = <0x5070400 0x400>;
			resets = <0x02 0x21>;
		};

		usbotg: usb@5100000 {
			clocks = <0x02 0x70>;
			compatible = "allwinner,sun50i-h616-musb", "allwinner,sun8i-h3-musb";
			dr_mode = "peripheral";
			extcon = <0x2a 0x00>;
			interrupt-names = "mc";
			interrupts = <0x00 0x19 0x04>;
			phandle = <0x89>;
			phy-names = "usb";
			phys = <0x2a 0x00>;
			reg = <0x5100000 0x400>;
			resets = <0x02 0x32>;
			status = "okay";
		};

		ehci0: usb@5101000 {
			clocks = <0x02 0x68 0x02 0x6c 0x02 0x60>;
			compatible = "allwinner,sun50i-h616-ehci", "generic-ehci";
			interrupts = <0x00 0x1a 0x04>;
			phandle = <0x8a>;
			phy-names = "usb";
			phys = <0x2a 0x00>;
			reg = <0x5101000 0x100>;
			resets = <0x02 0x2a 0x02 0x2e>;
			status = "okay";
		};

		ohci0: usb@5101400 {
			clocks = <0x02 0x68 0x02 0x60>;
			compatible = "allwinner,sun50i-h616-ohci", "generic-ohci";
			interrupts = <0x00 0x1b 0x04>;
			phandle = <0x8b>;
			phy-names = "usb";
			phys = <0x2a 0x00>;
			reg = <0x5101400 0x100>;
			resets = <0x02 0x2a>;
			status = "okay";
		};

		ehci1: usb@5200000 {
			clocks = <0x02 0x69 0x02 0x6d 0x02 0x62>;
			compatible = "allwinner,sun50i-h616-ehci", "generic-ehci";
			interrupts = <0x00 0x1c 0x04>;
			phandle = <0x8c>;
			phy-names = "usb";
			phys = <0x2a 0x01>;
			reg = <0x5200000 0x100>;
			resets = <0x02 0x2b 0x02 0x2f>;
			status = "okay";
		};

		ohci1: usb@5200400 {
			clocks = <0x02 0x69 0x02 0x62>;
			compatible = "allwinner,sun50i-h616-ohci", "generic-ohci";
			interrupts = <0x00 0x1d 0x04>;
			phandle = <0x8d>;
			phy-names = "usb";
			phys = <0x2a 0x01>;
			reg = <0x5200400 0x100>;
			resets = <0x02 0x2b>;
			status = "okay";
		};

		ehci2: usb@5310000 {
			clocks = <0x02 0x6a 0x02 0x6e 0x02 0x64>;
			compatible = "allwinner,sun50i-h616-ehci", "generic-ehci";
			interrupts = <0x00 0x1e 0x04>;
			phandle = <0x8e>;
			phy-names = "usb";
			phys = <0x2a 0x02>;
			reg = <0x5310000 0x100>;
			resets = <0x02 0x2c 0x02 0x30>;
			status = "okay";
		};

		ohci2: usb@5310400 {
			clocks = <0x02 0x6a 0x02 0x64>;
			compatible = "allwinner,sun50i-h616-ohci", "generic-ohci";
			interrupts = <0x00 0x1f 0x04>;
			phandle = <0x8f>;
			phy-names = "usb";
			phys = <0x2a 0x02>;
			reg = <0x5310400 0x100>;
			resets = <0x02 0x2c>;
			status = "okay";
		};

		ehci3: usb@5311000 {
			clocks = <0x02 0x6b 0x02 0x6f 0x02 0x66>;
			compatible = "allwinner,sun50i-h616-ehci", "generic-ehci";
			interrupts = <0x00 0x20 0x04>;
			phandle = <0x90>;
			phy-names = "usb";
			phys = <0x2a 0x03>;
			reg = <0x5311000 0x100>;
			resets = <0x02 0x2d 0x02 0x31>;
			status = "okay";
		};

		ohci3: usb@5311400 {
			clocks = <0x02 0x6b 0x02 0x66>;
			compatible = "allwinner,sun50i-h616-ohci", "generic-ohci";
			interrupts = <0x00 0x21 0x04>;
			phandle = <0x91>;
			phy-names = "usb";
			phys = <0x2a 0x03>;
			reg = <0x5311400 0x100>;
			resets = <0x02 0x2d>;
			status = "okay";
		};

		video-codec@1c0e000 {
			allwinner,sram = <0x11 0x01>;
			clock-names = "ahb", "mod", "ram";
			clocks = <0x02 0x29 0x02 0x28 0x02 0x33>;
			compatible = "allwinner,sun50i-h616-video-engine";
			interrupts = <0x00 0x5d 0x04>;
			reg = <0x1c0e000 0x2000>;
			resets = <0x02 0x05>;
		};

		watchdog: watchdog@30090a0 {
			clocks = <0x12>;
			compatible = "allwinner,sun50i-h616-wdt", "allwinner,sun6i-a31-wdt";
			interrupts = <0x00 0x32 0x04>;
			phandle = <0x47>;
			reg = <0x30090a0 0x20>;
		};
	};

	thermal-zones {

		cpu-thermal {
			polling-delay = <0x3e8>;
			polling-delay-passive = <0x1f4>;
			sustainable-power = <0x3e8>;
			thermal-sensors = <0x3b 0x02>;

			trips {

				cpu_threshold: cpu-trip-0 {
					hysteresis = <0x00>;
					phandle = <0xa3>;
					temperature = <0xea60>;
					type = "passive";
				};

				cpu_target: cpu-trip-1 {
					hysteresis = <0x00>;
					phandle = <0xa4>;
					temperature = <0x11170>;
					type = "passive";
				};

				cpu_critical: cpu-trip-2 {
					hysteresis = <0x00>;
					phandle = <0xa5>;
					temperature = <0x1adb0>;
					type = "critical";
				};
			};
		};

		ddr-thermal {
			polling-delay = <0x00>;
			polling-delay-passive = <0x00>;
			thermal-sensors = <0x3b 0x03>;

			trips {

				ddr_temp_critical: ddr-trip-0 {
					hysteresis = <0x00>;
					phandle = <0xa8>;
					temperature = <0x1adb0>;
					type = "critical";
				};
			};
		};

		gpu-thermal {
			polling-delay = <0x3e8>;
			polling-delay-passive = <0x1f4>;
			sustainable-power = <0x44c>;
			thermal-sensors = <0x3b 0x00>;

			trips {

				gpu_temp_critical: gpu-trip-0 {
					hysteresis = <0x00>;
					phandle = <0xa6>;
					temperature = <0x1adb0>;
					type = "critical";
				};
			};
		};

		ve-thermal {
			polling-delay = <0x00>;
			polling-delay-passive = <0x00>;
			thermal-sensors = <0x3b 0x01>;

			trips {

				ve_temp_critical: ve-trip-0 {
					hysteresis = <0x00>;
					phandle = <0xa7>;
					temperature = <0x1adb0>;
					type = "critical";
				};
			};
		};
	};

	timer {
		arm,no-tick-in-suspend;
		compatible = "arm,armv8-timer";
		interrupts = <0x01 0x0d 0xf04 0x01 0x0e 0xf04 0x01 0x0b 0xf04 0x01 0x0a 0xf04>;
	};

	reg_usb1_vbus: usb1-vbus {
		compatible = "regulator-fixed";
		enable-active-high;
		phandle = <0x2b>;
		regulator-max-microvolt = <0x4c4b40>;
		regulator-min-microvolt = <0x4c4b40>;
		regulator-name = "usb1-vbus";
		status = "okay";
		vin-supply = <0x39>;
	};

	reg_vcc5v: vcc5v {
		compatible = "regulator-fixed";
		phandle = <0x39>;
		regulator-always-on;
		regulator-max-microvolt = <0x4c4b40>;
		regulator-min-microvolt = <0x4c4b40>;
		regulator-name = "vcc-5v";
	};

	wifi_pwrseq: wifi-pwrseq {
		clock-names = "osc32k-out";
		clocks = <0x10 0x01>;
		compatible = "mmc-pwrseq-simple";
		phandle = <0x17>;
		post-power-on-delay-ms = <0xc8>;
		reset-gpios = <0x18 0x06 0x12 0x01>;
	};
};
