			resets = <0x02 0x3b>;
			status = "disabled";
		};

		mmc0: mmc@4020000 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			broken-cd;
			bus-width = <0x04>;
			cap-mmc-highspeed;
			cap-sd-highspeed;
			cap-sdio-irq;
			clock-names = "ahb", "mmc";
			clocks = <0x02 0x3f 0x02 0x3c>;
			compatible = "allwinner,sun50i-h616-mmc", "allwinner,sun50i-a100-mmc";
			interrupts = <0x00 0x23 0x04>;
			max-frequency = <0x8f0d180>;
