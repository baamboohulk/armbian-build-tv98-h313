			ths_calibration: thermal-sensor-calibration@14 {
				phandle = <0x25>;
				reg = <0x14 0x08>;
			};
		};

		emac0: ethernet@5020000 {
			clock-names = "stmmaceth";
			clocks = <0x02 0x52>;
			compatible = "allwinner,sun50i-h616-emac0", "allwinner,sun50i-a64-emac";
			interrupt-names = "macirq";
			interrupts = <0x00 0x0e 0x04>;
			phandle = <0x7b>;
			reg = <0x5020000 0x10000>;
			reset-names = "stmmaceth";
			resets = <0x02 0x1e>;
			status = "disabled";
			syscon = <0x20>;

			mdio0: mdio {
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				compatible = "snps,dwmac-mdio";
				phandle = <0x7c>;
			};
		};

		emac1: ethernet@5030000 {
			allwinner,rx-delay-ps = <0xc1c>;
			allwinner,tx-delay-ps = <0x2bc>;
			clock-names = "bus-emac1", "emac-25m";
			clocks = <0x02 0x53 0x02 0x51>;
			compatible = "allwinner,sunxi-gmac";
			gmac-power0;
			gmac-power1;
			gmac-power2;
			interrupt-names = "gmacirq";
			interrupts = <0x00 0x0f 0x04>;
			phandle = <0x7d>;
			phy-handle = <0x22>;
			phy-mode = "rmii";
			phy-rst;
			phy-supply = <0x23>;
			pinctrl-0 = <0x21>;
			pinctrl-names = "default";
			reg = <0x5030000 0x10000 0x3000034 0x04>;
			reg-names = "gmac1_reg", "ephy_reg";
			reset-names = "stmmaceth";
			resets = <0x02 0x1f>;
			rx-delay = <0x1f>;
			status = "okay";
			tx-delay = <0x07>;

			mdio1: mdio {
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				compatible = "ethernet-phy-ieee802.3-c22";
				phandle = <0x7e>;

				rmii_phy: ethernet-phy@0 {
					compatible = "ethernet-phy-ieee802.3-c22";
					phandle = <0x22>;
					reg = <0x00>;
				};
			};
		};

		gpu: gpu@1800000 {
			clock-names = "core", "bus";
			clocks = <0x02 0x23 0x02 0x24>;
			compatible = "allwinner,sun50i-h616-mali", "arm,mali-bifrost";
			interrupt-names = "job", "mmu", "gpu";
			interrupts = <0x00 0x5f 0x04 0x00 0x60 0x04 0x00 0x61 0x04>;
			mali-supply = <0x0f>;
			phandle = <0x40>;
			power-domains = <0x0e 0x02>;
			reg = <0x1800000 0x40000>;
			resets = <0x02 0x03>;
			status = "okay";
		};

		hdmi_phy: hdmi-phy@6010000 {
			#phy-cells = <0x00>;
			clock-names = "bus", "mod";
			clocks = <0x02 0x75 0x02 0x73>;
			compatible = "allwinner,sun50i-h616-hdmi-phy";
			phandle = <0x2c>;
			reg = <0x6010000 0x10000>;
			reset-names = "phy";
			resets = <0x02 0x34>;
		};

		hdmi: hdmi@6000000 {
			#sound-dai-cells = <0x00>;
			clock-names = "iahb", "isfr", "tmds", "cec", "hdcp", "hdcp-bus";
			clocks = <0x02 0x75 0x02 0x73 0x02 0x72 0x02 0x74 0x02 0x7e 0x02 0x7f>;
			compatible = "allwinner,sun50i-h616-dw-hdmi", "allwinner,sun50i-h6-dw-hdmi";
			hvcc-supply = <0x23>;
			interrupts = <0x00 0x3f 0x04>;
			phandle = <0x29>;
			phy-names = "phy";
			phys = <0x2c>;
			reg = <0x6000000 0x10000>;
			reg-io-width = <0x01>;
			reset-names = "ctrl", "hdcp";
			resets = <0x02 0x33 0x02 0x3a>;
			status = "okay";

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				hdmi_in: port@0 {
					phandle = <0x92>;
					reg = <0x00>;

					hdmi_in_tcon_top: endpoint {
						phandle = <0x32>;
						remote-endpoint = <0x2d>;
					};
				};

				hdmi_out: port@1 {
					phandle = <0x93>;
					reg = <0x01>;

					hdmi_out_con: endpoint {
						phandle = <0x3d>;
						remote-endpoint = <0x2e>;
					};
				};
			};
		};

		i2c0: i2c@5002000 {
			#address-cells = <0x01>;
