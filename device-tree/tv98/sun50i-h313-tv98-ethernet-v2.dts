		i2c3: i2c@5002c00 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			clocks = <0x02 0x4b>;
			compatible = "allwinner,sun50i-h616-i2c", "allwinner,sun8i-v536-i2c", "allwinner,sun6i-a31-i2c";
			dma-names = "rx", "tx";
			dmas = <0x1a 0x2e 0x1a 0x2e>;
			interrupts = <0x00 0x09 0x04>;
			phandle = <0x77>;
			reg = <0x5002c00 0x400>;
			resets = <0x02 0x1a>;
			status = "disabled";
		};

		i2c4: i2c@5003000 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			clocks = <0x02 0x4c>;
			compatible = "allwinner,sun50i-h616-i2c", "allwinner,sun8i-v536-i2c", "allwinner,sun6i-a31-i2c";
			dma-names = "rx", "tx";
			dmas = <0x1a 0x2f 0x1a 0x2f>;
			interrupts = <0x00 0x0a 0x04>;
			phandle = <0x78>;
			reg = <0x5003000 0x400>;
			resets = <0x02 0x1b>;
			status = "disabled";
		};

		r_i2c: i2c@7081400 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			clocks = <0x36 0x08>;
			compatible = "allwinner,sun50i-h616-i2c", "allwinner,sun8i-v536-i2c", "allwinner,sun6i-a31-i2c";
			dma-names = "rx", "tx";
			dmas = <0x1a 0x30 0x1a 0x30>;
			interrupts = <0x00 0x69 0x04>;
			phandle = <0x9d>;
			pinctrl-0 = <0x38>;
			pinctrl-names = "default";
			reg = <0x7081400 0x400>;
			resets = <0x36 0x04>;
			status = "okay";

			axp313a: pmic@36 {
				compatible = "x-powers,axp313a";
				phandle = <0x9e>;
				reg = <0x36>;
				vin1-supply = <0x39>;
				vin2-supply = <0x39>;
				vin3-supply = <0x39>;
				wakeup-source;

				regulators {

					reg_aldo1: aldo1 {
						phandle = <0x23>;
						regulator-always-on;
						regulator-max-microvolt = <0x1b7740>;
						regulator-min-microvolt = <0x1b7740>;
						regulator-name = "vcc1v8";
					};

					reg_dcdc1: dcdc1 {
						phandle = <0x0f>;
						regulator-always-on;
						regulator-max-microvolt = <0x11b340>;
						regulator-min-microvolt = <0xc5c10>;
						regulator-name = "vdd-gpu";
					};

					reg_dcdc2: dcdc2 {
						phandle = <0x05>;
						regulator-always-on;
						regulator-max-microvolt = <0x11b340>;
						regulator-min-microvolt = <0xc5c10>;
						regulator-name = "vdd-cpu";
					};

					reg_dcdc3: dcdc3 {
						phandle = <0x9f>;
						regulator-always-on;
						regulator-max-microvolt = <0x124f80>;
						regulator-min-microvolt = <0x124f80>;
						regulator-name = "vdd-dram";
					};

					reg_dldo1: dldo1 {
						phandle = <0x14>;
						regulator-always-on;
						regulator-max-microvolt = <0x325aa0>;
						regulator-min-microvolt = <0x325aa0>;
						regulator-name = "vcc3v3";
					};
				};
			};
		};

		gic: interrupt-controller@3021000 {
			#interrupt-cells = <0x03>;
			compatible = "arm,gic-400";
			interrupt-controller;
			interrupts = <0x01 0x09 0xf04>;
			phandle = <0x01>;
			reg = <0x3021000 0x1000 0x3022000 0x2000 0x3024000 0x2000 0x3026000 0x2000>;
		};

