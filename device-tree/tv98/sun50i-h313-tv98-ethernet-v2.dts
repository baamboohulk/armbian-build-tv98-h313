			resets = <0x36 0x05>;
			status = "okay";
		};

		tcon_tv: lcd-controller@6515000 {
			clock-names = "ahb", "tcon-ch1";
			clocks = <0x02 0x79 0x33 0x00>;
			compatible = "allwinner,sun50i-h6-tcon-tv", "allwinner,sun8i-r40-tcon-tv";
			interrupts = <0x00 0x42 0x04>;
			phandle = <0x98>;
			reg = <0x6515000 0x1000>;
			reset-names = "lcd";
			resets = <0x02 0x36>;

			ports {
				#address-cells = <0x01>;
