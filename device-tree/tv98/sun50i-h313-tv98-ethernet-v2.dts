			reg = <0x30f0000 0x10000>;
			resets = <0x02 0x0b>;
		};

		ir: ir@7040000 {
			clock-names = "apb", "ir";
			clocks = <0x36 0x09 0x36 0x0b>;
			compatible = "allwinner,sun50i-h616-ir", "allwinner,sun6i-a31-ir";
