/dts-v1/;

/ {
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	compatible = "hechuang,x96-q", "allwinner,sun50i-h616";
	interrupt-parent = <0x01>;
	model = "X96Q TV-Box LPDDR3";

	__symbols__ {
		addr_mgt = "/soc/addr-mgt";
		ahub1_codec = "/soc/ahub1_mach/soundcard-mach,codec";
		ahub1_cpu = "/soc/ahub1_mach/soundcard-mach,cpu";
		ahub1_mach = "/soc/ahub1_mach";
		ahub1_plat = "/soc/ahub1_plat";
		ahub_dam_mach = "/soc/ahub_dam_mach";
		ahub_dam_plat = "/soc/ahub_dam_plat@5097000";
		ahub_i2s1 = "/soc/ahub-i2s1@5097000";
		ahub_i2s2 = "/soc/ahub-i2s2@5097000";
		ahub_i2s3 = "/soc/ahub-i2s3@5097000";
		axp313a = "/soc/i2c@7081400/pmic@36";
		ccu = "/soc/clock@3001000";
		codec = "/soc/codec@05096000";
		cpu0 = "/cpus/cpu@0";
		cpu1 = "/cpus/cpu@1";
		cpu2 = "/cpus/cpu@2";
		cpu3 = "/cpus/cpu@3";
		cpu_critical = "/thermal-zones/cpu-thermal/trips/cpu-trip-2";
		cpu_opp_table = "/opp-table-cpu";
		cpu_speed_grade = "/soc/efuse@3006000/cpu-speed-grade@0";
		cpu_target = "/thermal-zones/cpu-thermal/trips/cpu-trip-1";
		cpu_threshold = "/thermal-zones/cpu-thermal/trips/cpu-trip-0";
		crypto = "/soc/crypto@1904000";
		ddr_temp_critical = "/thermal-zones/ddr-thermal/trips/ddr-trip-0";
		de = "/display-engine";
		de3_sram = "/soc/syscon@3000000/sram@28000/sram-section@0";
		display_clocks = "/soc/bus@1000000/clock@8000";
		dma = "/soc/dma-controller@3002000";
		dump_reg = "/soc/dump_reg@20000";
		ehci0 = "/soc/usb@5101000";
		ehci1 = "/soc/usb@5200000";
		ehci2 = "/soc/usb@5310000";
		ehci3 = "/soc/usb@5311000";
		emac0 = "/soc/ethernet@5020000";
		emac1 = "/soc/ethernet@5030000";
		ext_rgmii_pins = "/soc/pinctrl@300b000/rgmii-pins";
		gic = "/soc/interrupt-controller@3021000";
		gpadc = "/soc/adc@5070000";
		gpu = "/soc/gpu@1800000";
		gpu_temp_critical = "/thermal-zones/gpu-thermal/trips/gpu-trip-0";
		hdmi = "/soc/hdmi@6000000";
		hdmi_con_in = "/connector/port/endpoint";
		hdmi_in = "/soc/hdmi@6000000/ports/port@0";
		hdmi_in_tcon_top = "/soc/hdmi@6000000/ports/port@0/endpoint";
		hdmi_out = "/soc/hdmi@6000000/ports/port@1";
		hdmi_out_con = "/soc/hdmi@6000000/ports/port@1/endpoint";
		hdmi_phy = "/soc/hdmi-phy@6010000";
		i2c0 = "/soc/i2c@5002000";
		i2c0_pins = "/soc/pinctrl@300b000/i2c0-pins";
		i2c1 = "/soc/i2c@5002400";
		i2c1_pi_pins = "/soc/pinctrl@300b000/i2c1-pi-pins";
		i2c2 = "/soc/i2c@5002800";
		i2c2_ph_pins = "/soc/pinctrl@300b000/i2c2-ph-pins";
		i2c2_pi_pins = "/soc/pinctrl@300b000/i2c2-pi-pins";
		i2c3 = "/soc/i2c@5002c00";
		i2c3_pa_pins = "/soc/pinctrl@300b000/i2c3-pa-pins";
		i2c3_pg_pins = "/soc/pinctrl@300b000/i2c3-pg-pins";
		i2c3_ph_pins = "/soc/pinctrl@300b000/i2c3-ph-pins";
		i2c4 = "/soc/i2c@5003000";
		i2c4_pg_pins = "/soc/pinctrl@300b000/i2c4-pg-pins";
		i2c4_ph_pins = "/soc/pinctrl@300b000/i2c4-ph-pins";
		i2s2_pins = "/soc/pinctrl@300b000/i2s2-pins";
		i2s3_pins = "/soc/pinctrl@300b000/i2s3-pins";
		iommu = "/soc/iommu@30f0000";
		ir = "/soc/ir@7040000";
		ir_rx_pin = "/soc/pinctrl@300b000/ir-rx-pin";
		l2_cache = "/cpus/l2-cache";
		lradc = "/soc/lradc@5070800";
		mdio0 = "/soc/ethernet@5020000/mdio";
		mdio1 = "/soc/ethernet@5030000/mdio";
		mixer0 = "/soc/bus@1000000/mixer@100000";
		mixer0_out = "/soc/bus@1000000/mixer@100000/ports/port@1";
		mixer0_out_tcon_top_mixer0 = "/soc/bus@1000000/mixer@100000/ports/port@1/endpoint";
		mmc0 = "/soc/mmc@4020000";
		mmc0_pins = "/soc/pinctrl@300b000/mmc0-pins";
		mmc1 = "/soc/mmc@4021000";
		mmc1_pins = "/soc/pinctrl@300b000/mmc1-pins";
		mmc2 = "/soc/mmc@4022000";
		mmc2_pins = "/soc/pinctrl@300b000/mmc2-pins";
		nmi_intc = "/soc/interrupt-controller@7010320";
		ohci0 = "/soc/usb@5101400";
		ohci1 = "/soc/usb@5200400";
		ohci2 = "/soc/usb@5310400";
		ohci3 = "/soc/usb@5311400";
		osc24M = "/osc24M-clk";
		pio = "/soc/pinctrl@300b000";
		prcm_ppu = "/soc/power-controller@7010250";
		pwm1_pg_pin = "/soc/pinctrl@300b000/pwm1-pg-pin";
		pwm1_ph_pin = "/soc/pinctrl@300b000/pwm1-ph-pin";
		pwm1_pi_pin = "/soc/pinctrl@300b000/pwm1-pi-pin";
		pwm2_ph_pin = "/soc/pinctrl@300b000/pwm2-ph-pin";
		pwm3_ph_pin = "/soc/pinctrl@300b000/pwm3-ph-pin";
		pwm4_ph_pin = "/soc/pinctrl@300b000/pwm4-ph-pin";
		pwm5_pin = "/soc/pinctrl@300b000/pwm5-pin";
		r_ccu = "/soc/clock@7010000";
		r_i2c = "/soc/i2c@7081400";
		r_i2c_pins = "/soc/pinctrl@7022000/r-i2c-pins";
		r_pio = "/soc/pinctrl@7022000";
		r_rsb = "/soc/rsb@7083000";
		r_rsb_pins = "/soc/pinctrl@7022000/r-rsb-pins";
		reg_aldo1 = "/soc/i2c@7081400/pmic@36/regulators/aldo1";
		reg_dcdc1 = "/soc/i2c@7081400/pmic@36/regulators/dcdc1";
		reg_dcdc2 = "/soc/i2c@7081400/pmic@36/regulators/dcdc2";
		reg_dcdc3 = "/soc/i2c@7081400/pmic@36/regulators/dcdc3";
		reg_dldo1 = "/soc/i2c@7081400/pmic@36/regulators/dldo1";
		reg_usb1_vbus = "/usb1-vbus";
		reg_vcc5v = "/vcc5v";
		reg_vcc_wifi = "/reg_vcc_wifi";
		rmii_phy = "/soc/ethernet@5030000/mdio/ethernet-phy@0";
		rmii_pins = "/soc/pinctrl@300b000/rmii-pins";
		rtc = "/soc/rtc@7000000";
		scpi_sram = "/soc/syscon@3000000/sram@100000/scpi-sram@17c00";
		sid = "/soc/efuse@3006000";
		spdif = "/soc/spdif@5093000";
		spdif_tx_pin = "/soc/pinctrl@300b000/spdif-tx-pin";
		spi0 = "/soc/spi@5010000";
		spi0_cs0_pin = "/soc/pinctrl@300b000/spi0-cs0-pin";
		spi0_pins = "/soc/pinctrl@300b000/spi0-pins";
		spi1 = "/soc/spi@5011000";
		spi1_cs0_pin = "/soc/pinctrl@300b000/spi1-cs0-pin";
		spi1_cs1_pin = "/soc/pinctrl@300b000/spi1-cs1-pin";
		spi1_pins = "/soc/pinctrl@300b000/spi1-pins";
		sram_a2 = "/soc/syscon@3000000/sram@100000";
		sram_c = "/soc/syscon@3000000/sram@28000";
		sram_c1 = "/soc/syscon@3000000/sram@1a00000";
		syscon = "/soc/syscon@3000000";
		tcon_top = "/soc/tcon-top@6510000";
		tcon_top_hdmi_in = "/soc/tcon-top@6510000/ports/port@4";
		tcon_top_hdmi_in_tcon_tv = "/soc/tcon-top@6510000/ports/port@4/endpoint@0";
		tcon_top_hdmi_out = "/soc/tcon-top@6510000/ports/port@5";
		tcon_top_hdmi_out_hdmi = "/soc/tcon-top@6510000/ports/port@5/endpoint";
		tcon_top_mixer0_in = "/soc/tcon-top@6510000/ports/port@0";
		tcon_top_mixer0_in_mixer0 = "/soc/tcon-top@6510000/ports/port@0/endpoint@0";
		tcon_top_mixer0_out = "/soc/tcon-top@6510000/ports/port@1";
		tcon_top_mixer0_out_tcon_tv = "/soc/tcon-top@6510000/ports/port@1/endpoint@2";
		tcon_tv = "/soc/lcd-controller@6515000";
		tcon_tv_in = "/soc/lcd-controller@6515000/ports/port@0";
		tcon_tv_in_tcon_top_mixer0 = "/soc/lcd-controller@6515000/ports/port@0/endpoint";
		tcon_tv_out = "/soc/lcd-controller@6515000/ports/port@1";
		tcon_tv_out_tcon_top = "/soc/lcd-controller@6515000/ports/port@1/endpoint@1";
		ths = "/soc/thermal-sensor@5070400";
		ths_calibration = "/soc/efuse@3006000/thermal-sensor-calibration@14";
		uart0 = "/soc/serial@5000000";
		uart0_ph_pins = "/soc/pinctrl@300b000/uart0-ph-pins";
		uart1 = "/soc/serial@5000400";
		uart1_pins = "/soc/pinctrl@300b000/uart1-pins";
		uart1_rts_cts_pins = "/soc/pinctrl@300b000/uart1-rts-cts-pins";
		uart2 = "/soc/serial@5000800";
		uart2_pg_pins = "/soc/pinctrl@300b000/uart2-pg-pins";
		uart2_pg_rts_cts_pins = "/soc/pinctrl@300b000/uart2-pg-rts-cts-pins";
		uart2_ph_pins = "/soc/pinctrl@300b000/uart2-ph-pins";
		uart2_ph_rts_cts_pins = "/soc/pinctrl@300b000/uart2-ph-rts-cts-pins";
		uart2_pi_pins = "/soc/pinctrl@300b000/uart2-pi-pins";
		uart3 = "/soc/serial@5000c00";
		uart3_pi_pins = "/soc/pinctrl@300b000/uart3-pi-pins";
		uart4 = "/soc/serial@5001000";
		uart4_pi_pins = "/soc/pinctrl@300b000/uart4-pi-pins";
		uart4_pi_rts_cts_pins = "/soc/pinctrl@300b000/uart4-pi-rts-cts-pins";
		uart5 = "/soc/serial@5001400";
		uart5_pins = "/soc/pinctrl@300b000/uart5-pins";
		usbotg = "/soc/usb@5100000";
		usbphy = "/soc/phy@5100400";
		ve_sram = "/soc/syscon@3000000/sram@1a00000/sram-section@0";
		ve_temp_critical = "/thermal-zones/ve-thermal/trips/ve-trip-0";
		watchdog = "/soc/watchdog@30090a0";
		wifi_pwrseq = "/wifi-pwrseq";
		wlan = "/soc/mmc@4021000/wifi@1";
		x32clk_fanout_pin = "/soc/pinctrl@300b000/x32clk-fanout-pin";
	};

	aliases {
		ethernet0 = "/soc/ethernet@5030000";
		ethernet1 = "/soc/mmc@4021000/wifi@1";
		mmc0 = "/soc/mmc@4020000";
		mmc2 = "/soc/mmc@4022000";
		serial0 = "/soc/serial@5000000";
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	connector {
		compatible = "hdmi-connector";
		type = "d";

		port {

			hdmi_con_in: endpoint {
				phandle = <0x2e>;
				remote-endpoint = <0x3d>;
			};
		};
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu0: cpu@0 {
			#cooling-cells = <0x02>;
			clocks = <0x02 0x15>;
			compatible = "arm,cortex-a53";
			cpu-supply = <0x05>;
			d-cache-line-size = <0x40>;
			d-cache-sets = <0x80>;
			d-cache-size = <0x8000>;
			device_type = "cpu";
			enable-method = "psci";
			i-cache-line-size = <0x40>;
			i-cache-sets = <0x100>;
			i-cache-size = <0x8000>;
			next-level-cache = <0x03>;
			operating-points-v2 = <0x04>;
			phandle = <0x07>;
			reg = <0x00>;
			status = "okay";
		};

		cpu1: cpu@1 {
			#cooling-cells = <0x02>;
			clocks = <0x02 0x15>;
			compatible = "arm,cortex-a53";
			d-cache-line-size = <0x40>;
			d-cache-sets = <0x80>;
			d-cache-size = <0x8000>;
			device_type = "cpu";
			enable-method = "psci";
			i-cache-line-size = <0x40>;
			i-cache-sets = <0x100>;
			i-cache-size = <0x8000>;
			next-level-cache = <0x03>;
			operating-points-v2 = <0x04>;
			phandle = <0x08>;
			reg = <0x01>;
		};

		cpu2: cpu@2 {
			#cooling-cells = <0x02>;
			clocks = <0x02 0x15>;
			compatible = "arm,cortex-a53";
			d-cache-line-size = <0x40>;
			d-cache-sets = <0x80>;
			d-cache-size = <0x8000>;
			device_type = "cpu";
			enable-method = "psci";
			i-cache-line-size = <0x40>;
			i-cache-sets = <0x100>;
			i-cache-size = <0x8000>;
			next-level-cache = <0x03>;
			operating-points-v2 = <0x04>;
			phandle = <0x09>;
			reg = <0x02>;
		};

		cpu3: cpu@3 {
			#cooling-cells = <0x02>;
			clocks = <0x02 0x15>;
			compatible = "arm,cortex-a53";
			d-cache-line-size = <0x40>;
			d-cache-sets = <0x80>;
			d-cache-size = <0x8000>;
			device_type = "cpu";
			enable-method = "psci";
			i-cache-line-size = <0x40>;
			i-cache-sets = <0x100>;
			i-cache-size = <0x8000>;
			next-level-cache = <0x03>;
			operating-points-v2 = <0x04>;
			phandle = <0x0a>;
			reg = <0x03>;
		};

		l2_cache: l2-cache {
			cache-level = <0x02>;
			cache-line-size = <0x40>;
			cache-sets = <0x100>;
			cache-size = <0x40000>;
			cache-unified;
			compatible = "cache";
			phandle = <0x03>;
		};
	};

	de: display-engine {
		allwinner,pipelines = <0x06>;
		compatible = "allwinner,sun50i-h6-display-engine";
		phandle = <0x3e>;
		status = "okay";
	};

	leds {
		compatible = "gpio-leds";

		led-red {
			color = <0x01>;
			function = "disk-activity";
			gpios = <0x18 0x07 0x06 0x00>;
			linux,default-trigger = "mmc0";
		};
	};

	cpu_opp_table: opp-table-cpu {
		compatible = "allwinner,sun50i-h616-operating-points";
		nvmem-cells = <0x3c>;
		opp-shared;
		phandle = <0x04>;

		opp-1008000000 {
			clock-latency-ns = <0x3b9b0>;
			opp-hz = <0x00 0x3c14dc00>;
			opp-microvolt-speed0 = <0xe09c0 0xe09c0 0x10c8e0>;
			opp-microvolt-speed1 = <0xe09c0 0xe09c0 0x10c8e0>;
			opp-microvolt-speed2 = <0xe09c0 0xe09c0 0x10c8e0>;
		};

		opp-1200000000 {
			clock-latency-ns = <0x3b9b0>;
			opp-hz = <0x00 0x47868c00>;
			opp-microvolt-speed0 = <0xef420 0xef420 0x10c8e0>;
			opp-microvolt-speed1 = <0xef420 0xef420 0x10c8e0>;
			opp-microvolt-speed2 = <0xef420 0xef420 0x10c8e0>;
		};

		opp-1512000000 {
			clock-latency-ns = <0x3b9b0>;
			opp-hz = <0x00 0x5a1f4a00>;
			opp-microvolt-speed0 = <0x10c8e0 0x10c8e0 0x10c8e0>;
			opp-microvolt-speed1 = <0x10c8e0 0x10c8e0 0x10c8e0>;
			opp-microvolt-speed2 = <0x10c8e0 0x10c8e0 0x10c8e0>;
		};

		opp-480000000 {
			clock-latency-ns = <0x3b9b0>;
			opp-hz = <0x00 0x1c9c3800>;
			opp-microvolt-speed0 = <0xdbba0 0xdbba0 0x10c8e0>;
			opp-microvolt-speed1 = <0xdbba0 0xdbba0 0x10c8e0>;
			opp-microvolt-speed2 = <0xdbba0 0xdbba0 0x10c8e0>;
		};

		opp-600000000 {
			clock-latency-ns = <0x3b9b0>;
			opp-hz = <0x00 0x23c34600>;
			opp-microvolt-speed0 = <0xdbba0 0xdbba0 0x10c8e0>;
			opp-microvolt-speed1 = <0xdbba0 0xdbba0 0x10c8e0>;
			opp-microvolt-speed2 = <0xdbba0 0xdbba0 0x10c8e0>;
		};

		opp-792000000 {
			clock-latency-ns = <0x3b9b0>;
			opp-hz = <0x00 0x2f34f600>;
			opp-microvolt-speed0 = <0xdbba0 0xdbba0 0x10c8e0>;
			opp-microvolt-speed1 = <0xdbba0 0xdbba0 0x10c8e0>;
			opp-microvolt-speed2 = <0xdbba0 0xdbba0 0x10c8e0>;
		};
	};

	osc24M: osc24M-clk {
		#clock-cells = <0x00>;
		clock-frequency = <0x16e3600>;
		clock-output-names = "osc24M";
		compatible = "fixed-clock";
		phandle = <0x12>;
	};

	pmu {
		compatible = "arm,cortex-a53-pmu";
		interrupt-affinity = <0x07 0x08 0x09 0x0a>;
		interrupts = <0x00 0x8c 0x04 0x00 0x8d 0x04 0x00 0x8e 0x04 0x00 0x8f 0x04>;
	};

	psci {
		compatible = "arm,psci-0.2";
		method = "smc";
	};

	reg_vcc_wifi: reg_vcc_wifi {
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <0x18 0x06 0x12 0x00>;
		phandle = <0x16>;
		regulator-always-on;
		regulator-max-microvolt = <0x325aa0>;
		regulator-min-microvolt = <0x325aa0>;
		regulator-name = "vcc-wifi";
		status = "okay";
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		secmon@40000000 {
			no-map;
			reg = <0x00 0x40000000 0x00 0x80000>;
		};
	};

	soc {
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		compatible = "simple-bus";
		ranges = <0x00 0x00 0x00 0x40000000>;

		gpadc: adc@5070000 {
			#io-channel-cells = <0x01>;
			clocks = <0x02 0x81>;
			compatible = "allwinner,sun50i-h616-gpadc", "allwinner,sun20i-d1-gpadc";
			interrupts = <0x00 0x12 0x04>;
			phandle = <0x80>;
			reg = <0x5070000 0x400>;
			resets = <0x02 0x3c>;
			status = "disabled";
		};

		addr_mgt: addr-mgt {
			compatible = "allwinner,sunxi-addr_mgt";
			phandle = <0xa2>;
			status = "okay";
			type_addr_bt = <0x02>;
			type_addr_eth = <0x02>;
			type_addr_wifi = <0x02>;
		};

		ahub_i2s1: ahub-i2s1@5097000 {
			#sound-dai-cells = <0x00>;
			audio_format = <0x01>;
			clock-names = "apb", "audio-codec-1x", "audio-codec-4x", "audio-hub";
			clocks = <0x02 0x5f 0x02 0x5b 0x02 0x5c 0x02 0x5e>;
			compatible = "allwinner,sunxi-ahub-daudio";
			daudio_master = <0x04>;
			frametype = <0x00>;
			mclk_div = <0x01>;
			pcm_lrck_period = <0x20>;
			phandle = <0x86>;
			pinconfig = <0x00>;
			reg = <0x5097000 0xadf>;
			signal_inversion = <0x01>;
			slot_width_select = <0x20>;
			status = "disabled";
			tdm_config = <0x01>;
			tdm_num = <0x01>;
		};

		ahub_i2s2: ahub-i2s2@5097000 {
			audio_format = <0x01>;
			clock-names = "apb", "audio-codec-1x", "audio-codec-4x", "audio-hub";
			clocks = <0x02 0x5f 0x02 0x5b 0x02 0x5c 0x02 0x5e>;
			compatible = "allwinner,sunxi-ahub-daudio";
			daudio_master = <0x04>;
			frametype = <0x00>;
			mclk_div = <0x04>;
			pcm_lrck_period = <0x20>;
			phandle = <0x87>;
			pinconfig = <0x01>;
			reg = <0x5097000 0xadf>;
			signal_inversion = <0x01>;
			slot_width_select = <0x20>;
			status = "disabled";
			tdm_config = <0x01>;
			tdm_num = <0x02>;
		};

		ahub_i2s3: ahub-i2s3@5097000 {
			audio_format = <0x01>;
			clock-names = "apb", "audio-codec-1x", "audio-codec-4x", "audio-hub";
			clocks = <0x02 0x5f 0x02 0x5b 0x02 0x5c 0x02 0x5e>;
			compatible = "allwinner,sunxi-ahub-daudio";
			daudio_master = <0x04>;
			frametype = <0x00>;
			mclk_div = <0x04>;
			pcm_lrck_period = <0x20>;
			phandle = <0x88>;
			pinconfig = <0x01>;
			reg = <0x5097000 0xadf>;
			signal_inversion = <0x01>;
			slot_width_select = <0x20>;
			status = "disabled";
			tdm_config = <0x01>;
			tdm_num = <0x03>;
		};

		ahub1_mach: ahub1_mach {
			compatible = "allwinner,sunxi-snd-mach";
			phandle = <0x84>;
			soundcard-mach,bitclock-master = <0x27>;
			soundcard-mach,format = "i2s";
			soundcard-mach,frame-master = <0x27>;
			soundcard-mach,name = "HDMI";
			soundcard-mach,slot-num = <0x02>;
			soundcard-mach,slot-width = <0x20>;
			status = "okay";

			ahub1_codec: soundcard-mach,codec {
				phandle = <0x85>;
				sound-dai = <0x29>;
			};

			ahub1_cpu: soundcard-mach,cpu {
				phandle = <0x27>;
				sound-dai = <0x28>;
				soundcard-mach,mclk-fs = <0x00>;
				soundcard-mach,pll-fs = <0x04>;
			};
		};

		ahub1_plat: ahub1_plat {
			#sound-dai-cells = <0x00>;
			apb_num = <0x01>;
			capture_cma = <0x80>;
			compatible = "allwinner,sunxi-snd-plat-ahub";
			dma-names = "tx", "rx";
			dmas = <0x1a 0x04 0x1a 0x04>;
			phandle = <0x28>;
			playback_cma = <0x80>;
			rx_fifo_size = <0x80>;
			rx_pin = <0x00>;
			status = "okay";
			tdm_num = <0x01>;
			tx_fifo_size = <0x80>;
			tx_pin = <0x00>;
		};

		ahub_dam_mach: ahub_dam_mach {
			compatible = "allwinner,sunxi-snd-mach";
			phandle = <0x83>;
			soundcard-mach,name = "ahubdam";
			status = "disabled";

			soundcard-mach,codec {
			};

			soundcard-mach,cpu {
				sound-dai = <0x26>;
			};
		};

		ahub_dam_plat: ahub_dam_plat@5097000 {
			#sound-dai-cells = <0x00>;
			clock-names = "clk_pll_audio", "clk_pll_audio_4x", "clk_audio_hub", "clk_bus_audio_hub";
			clocks = <0x02 0x5b 0x02 0x5c 0x02 0x5e 0x02 0x5f>;
			compatible = "allwinner,sunxi-snd-plat-ahub_dam";
			phandle = <0x26>;
			reg = <0x5097000 0x1000>;
			resets = <0x02 0x25>;
			status = "okay";
		};

		bus@1000000 {
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			allwinner,sram = <0x0b 0x01>;
			compatible = "allwinner,sun50i-h616-de33", "allwinner,sun50i-a64-de2";
			ranges = <0x00 0x1000000 0x400000>;
			reg = <0x1000000 0x400000>;

			display_clocks: clock@8000 {
				#clock-cells = <0x01>;
				#reset-cells = <0x01>;
				clock-names = "mod", "bus";
				clocks = <0x02 0x1d 0x02 0x1e>;
				compatible = "allwinner,sun50i-h616-de33-clk";
				phandle = <0x0c>;
				reg = <0x8000 0x100>;
				resets = <0x02 0x01>;
			};

			mixer0: mixer@100000 {
				clock-names = "bus", "mod";
				clocks = <0x0c 0x00 0x0c 0x06>;
				compatible = "allwinner,sun50i-h616-de33-mixer-0";
				phandle = <0x06>;
				reg = <0x100000 0x100000 0x8100 0x40 0x280000 0x20000>;
				resets = <0x0c 0x00>;

				ports {
					#address-cells = <0x01>;
					#size-cells = <0x00>;

					mixer0_out: port@1 {
						phandle = <0x3f>;
						reg = <0x01>;

						mixer0_out_tcon_top_mixer0: endpoint {
							phandle = <0x2f>;
							remote-endpoint = <0x0d>;
						};
					};
				};
			};
		};

		ccu: clock@3001000 {
			#clock-cells = <0x01>;
			#reset-cells = <0x01>;
			clock-names = "hosc", "losc", "iosc";
			clocks = <0x12 0x10 0x00 0x10 0x02>;
			compatible = "allwinner,sun50i-h616-ccu";
			phandle = <0x02>;
			reg = <0x3001000 0x1000>;
		};

		r_ccu: clock@7010000 {
			#clock-cells = <0x01>;
			#reset-cells = <0x01>;
			clock-names = "hosc", "losc", "iosc", "pll-periph";
			clocks = <0x12 0x10 0x00 0x10 0x02 0x02 0x04>;
			compatible = "allwinner,sun50i-h616-r-ccu";
			phandle = <0x36>;
			reg = <0x7010000 0x210>;
		};

		codec: codec@05096000 {
			#sound-dai-cells = <0x00>;
			allwinner,audio-routing = "Line Out", "LINEOUT";
			clock-names = "apb", "audio-codec-1x", "audio-codec-4x";
			clocks = <0x02 0x5d 0x02 0x5b 0x02 0x5c>;
			compatible = "allwinner,sun50i-h616-codec";
			dma-names = "tx";
			dmas = <0x1a 0x06>;
			interrupts = <0x00 0x3a 0x04>;
			phandle = <0x82>;
			reg = <0x5096000 0x31c>;
			resets = <0x02 0x24>;
			status = "okay";
		};

		crypto: crypto@1904000 {
			clock-names = "bus", "mod", "ram", "trng";
			clocks = <0x02 0x27 0x02 0x26 0x02 0x34 0x10 0x02>;
			compatible = "allwinner,sun50i-h616-crypto";
			interrupts = <0x00 0x5b 0x04>;
			phandle = <0x41>;
			reg = <0x1904000 0x800>;
			resets = <0x02 0x04>;
		};

		dma: dma-controller@3002000 {
			#dma-cells = <0x01>;
			clock-names = "bus", "mbus";
			clocks = <0x02 0x2a 0x02 0x32>;
			compatible = "allwinner,sun50i-h616-dma", "allwinner,sun50i-a100-dma";
			dma-channels = <0x10>;
			dma-requests = <0x31>;
			interrupts = <0x00 0x2a 0x04>;
			phandle = <0x1a>;
			reg = <0x3002000 0x1000>;
			resets = <0x02 0x06>;
		};

		dump_reg: dump_reg@20000 {
			compatible = "allwinner,sunxi-dump-reg";
			phandle = <0xa1>;
			reg = <0x00 0x3001000 0x00 0xf20>;
			status = "okay";
		};

		sid: efuse@3006000 {
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			compatible = "allwinner,sun50i-h616-sid", "allwinner,sun50i-a64-sid";
			phandle = <0x46>;
			reg = <0x3006000 0x1000>;

			cpu_speed_grade: cpu-speed-grade@0 {
				phandle = <0x3c>;
				reg = <0x00 0x02>;
