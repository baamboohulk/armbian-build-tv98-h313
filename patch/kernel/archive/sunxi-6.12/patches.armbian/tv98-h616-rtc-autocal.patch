--- a/drivers/rtc/rtc-sun6i.c
+++ b/drivers/rtc/rtc-sun6i.c
@@ -41,6 +41,11 @@
 #define SUN6I_LOSC_CTRL_ACC_MASK		GENMASK(9, 7)
 
 #define SUN6I_LOSC_CLK_PRESCAL			0x0008
+
+#define SUN6I_LOSC_CLK_AUTO_CAL       0x000c
+#define SUN6I_LOSC_CLK_AUTO_CAL_16MS  BIT(2)
+#define SUN6I_LOSC_CLK_AUTO_CAL_EN    BIT(1)
+#define SUN6I_LOSC_CLK_AUTO_CAL_SEL   BIT(0)
 
 /* RTC */
 #define SUN6I_RTC_YMD				0x0010
@@ -138,6 +143,7 @@
 	unsigned int has_losc_en : 1;
 	unsigned int has_auto_swt : 1;
 	unsigned int no_ext_losc : 1;
+	unsigned int has_auto_cal : 1;
 };
 
 #define RTC_LINEAR_DAY	BIT(0)
@@ -268,6 +274,16 @@
 	}
 	writel(reg, rtc->base + SUN6I_LOSC_CTRL);
 
+	if (rtc->data->has_auto_cal) {
+		/* Enable calibrated internal 32 kHz RC clock. */
+		reg = readl(rtc->base + SUN6I_LOSC_CLK_AUTO_CAL);
+		reg &= ~(BIT(3) | BIT(2));
+		reg |= SUN6I_LOSC_CLK_AUTO_CAL_16MS |
+		       SUN6I_LOSC_CLK_AUTO_CAL_EN |
+		       SUN6I_LOSC_CLK_AUTO_CAL_SEL;
+		writel(reg, rtc->base + SUN6I_LOSC_CLK_AUTO_CAL);
+	}
+
 	/* Yes, I know, this is ugly. */
 	sun6i_rtc = rtc;
 
@@ -395,6 +411,7 @@
 	.has_prescaler = 1,
 	.has_out_clk = 1,
 	.no_ext_losc = 1,
+	.has_auto_cal = 1,
 };
 
 static void __init sun50i_h616_rtc_clk_init(struct device_node *node)
